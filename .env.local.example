# Copy this file to .env.local and fill in your values.

# Required for the contact form to send lead emails.
# Sign up free at https://resend.com → API Keys → Create API Key
# Free tier: 3,000 emails/month, no credit card required.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Note: In development (npm run dev), if RESEND_API_KEY is not set,
# form submissions will still succeed but emails are only logged to the console.
# This lets you test the full UI flow without an email account.

# Optional, for testing only. When set, every "Send This Attorney a Message"
# lead is emailed to this address (with the site owner copied) as if it were
# the attorney's email on file. Use it on a Preview deployment to try the
# "attorney has an email" path without emailing a real law firm.
# Leave it unset in Production.
# ATTORNEY_EMAIL_OVERRIDE=you+attorneytest@example.com

# "Verify your listing" (attorneys confirm their details and add an email).
# 1. A long random phrase, at least 16 characters, used to sign the links in
#    the confirmation and approve/reject emails. Keep it secret; changing it
#    makes links in emails already sent stop working.
# VERIFY_LISTING_SECRET=
# 2. The database that holds verified emails. In Vercel: Storage -> Create ->
#    Upstash for Redis -> connect it to this project. Vercel then adds these
#    two by itself; you do not type them.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Only for the blog pipeline (scripts/README.md), never needed by the website.
# Set it in your terminal when you run the pipeline rather than in this file:
#   ANTHROPIC_API_KEY=sk-ant-... node scripts/run-pipeline.js <export.zip>
